#!/usr/bin/env bash
# Refuses a push to main or preview whose committed frontend/dist/entry.js is stale.
# Enable once per clone: git config core.hooksPath glide/githooks
set -euo pipefail
zero=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha remote_ref _; do
  [[ $local_sha == "$zero" ]] && continue
  case $remote_ref in refs/heads/main|refs/heads/preview) ;; *) continue ;; esac
  "$(git rev-parse --show-toplevel)/glide/tools/dist-fresh.sh" "$local_sha" || status=1
done
exit $status
